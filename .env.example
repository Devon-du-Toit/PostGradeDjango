# Database vars
DB_NAME=postgrade
DB_USER=postgrade_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5433

# DEBUG mode for local development, KEEP TRUE!!!
DEBUG=True

# SECRET KEY, NEVER PUSH OR EXPOSE
SECRET_KEY=your-django-secret-key

# Verified script email release: "automatic" or "approval"
SCRIPT_EMAIL_RELEASE_POLICY=automatic

# --- Production / hosting (see DOCS/DEPLOYMENT.md) ---------------------
# Local development can leave these unset: the defaults are the local values.

# Comma-separated host names the API answers on
# ALLOWED_HOSTS=api.postgrade.example.com
# Frontend origin(s) allowed to call the API from the browser
# CORS_ALLOWED_ORIGINS=https://postgrade.example.com
# HTTPS origins allowed to post forms (Django admin)
# CSRF_TRUSTED_ORIGINS=https://api.postgrade.example.com

# HTTPS behind the hosting proxy
# SECURE_SSL_REDIRECT=true
# Enable only once HTTPS is confirmed working (browsers then refuse HTTP)
# SECURE_HSTS_SECONDS=31536000

# Reuse database connections for this many seconds (production: 60)
# DB_CONN_MAX_AGE=60

# Uploaded scripts and recognition crops (a persistent volume in containers)
# MEDIA_ROOT=/data/media

# Private original-script ZIP export (DOCS/SCRIPT_EXPORT.md).
# MAX_SCRIPT_EXPORT_FILES=1000
# MAX_SCRIPT_EXPORT_BYTES=536870912

# SMTP for verified script emails (development prints emails to the console)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=PostGrade <noreply@example.com>

# Account lifecycle (DOCS/PERMISSIONS.md). Lecturer signup is always available.
# Self-service recovery: production is closed until explicitly configured.
# ALLOW_PASSWORD_RECOVERY=false
# PASSWORD_RESET_FRONTEND_URL=  # approved HTTPS frontend reset-password page
# PASSWORD_RESET_THROTTLE_RATE=5/hour
# PASSWORD_RESET_CONFIRM_THROTTLE_RATE=10/hour
# LOGIN_THROTTLE_RATE=10/min
# REGISTER_THROTTLE_RATE=5/hour
# REFRESH_THROTTLE_RATE=30/min
# LOGOUT_THROTTLE_RATE=30/min
# Trusted proxy depth; leave 0 without a proxy. Proxy must replace forwarding headers.
# NUM_PROXIES=0

# Retained pages per QR group, including excluded duplicates.
MAX_QR_GROUP_PAGES=100
